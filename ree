<script>
  // ─── PAGE SWITCH ───
  function showPage(page) {
    document.querySelectorAll('.page').forEach(p => p.classList.remove('active'));
    document.querySelectorAll('.nav-btn').forEach(b => b.classList.remove('active'));
    document.getElementById('page-' + page).classList.add('active');
    document.querySelector('.nav-btn.' + page).classList.add('active');

    // Re-trigger animations
    document.querySelectorAll('#page-' + page + ' .reveal').forEach(el => {
      el.classList.remove('visible');
      setTimeout(() => checkReveal(), 100);
    });

    window.scrollTo({ top: 0, behavior: 'smooth' });
  }

  // ─── SCROLL REVEAL ───
  function checkReveal() {
    const reveals = document.querySelectorAll('.page.active .reveal');
    reveals.forEach(el => {
      const rect = el.getBoundingClientRect();
      if (rect.top < window.innerHeight * 0.88) {
        el.classList.add('visible');
      }
    });
  }

  window.addEventListener('scroll', checkReveal);
  setTimeout(checkReveal, 200);

  // ─── FLOATING KANJI ───
  const kanjis = ['呪', '術', '廻', '戦', '滅', '霊', '縛', '解', '蒼', '赫', '紫', '無', '極', '限', '力', '道', '血', '魂', '破', '天'];

  function spawnKanji(containerId, color) {
    const container = document.getElementById(containerId);
    if (!container) return;

    const el = document.createElement('div');
    el.className = 'kanji-char';
    el.textContent = kanjis[Math.floor(Math.random() * kanjis.length)];
    el.style.left = Math.random() * 100 + '%';
    el.style.fontSize = (Math.random() * 80 + 40) + 'px';
    el.style.color = color;
    el.style.animationDuration = (Math.random() * 15 + 10) + 's';
    el.style.animationDelay = (Math.random() * 5) + 's';
    container.appendChild(el);

    setTimeout(() => el.remove(), 30000);
  }

  setInterval(() => {
    if (document.getElementById('page-exo').classList.contains('active')) {
      spawnKanji('kanji-exo', '#4dd0e1');
    } else {
      spawnKanji('kanji-cult', '#ff1744');
    }
  }, 2500);

  // Initial spawn
  for (let i = 0; i < 6; i++) {
    setTimeout(() => spawnKanji('kanji-exo', '#4dd0e1'), i * 500);
    setTimeout(() => spawnKanji('kanji-cult', '#ff1744'), i * 500);
  }
</script>

