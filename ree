<!DOCTYPE html>

<html lang="fr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>L'Ère de la Fracture</title>
<link href="https://fonts.googleapis.com/css2?family=Noto+Serif+JP:wght@400;700;900&family=Cinzel+Decorative:wght@400;700;900&family=Sawarabi+Mincho&family=Bebas+Neue&display=swap" rel="stylesheet">
<style>
  :root {
    --gold: #c9a84c;
    --gold-light: #f0d078;
    --blood: #8b0000;
    --blood-light: #cc2200;
    --void: #080808;
    --dark: #0d0d0d;
    --dark2: #141414;
    --dark3: #1a1a1a;
    --exo-blue: #1a3a5c;
    --exo-cyan: #4dd0e1;
    --exo-accent: #00bcd4;
    --cult-red: #4a0000;
    --cult-crimson: #c62828;
    --cult-accent: #ff1744;
    --text-light: #e8e0d0;
    --text-muted: #9a9080;
  }

- { margin: 0; padding: 0; box-sizing: border-box; }

html { scroll-behavior: smooth; }

body {
background: var(–void);
color: var(–text-light);
font-family: ‘Sawarabi Mincho’, serif;
overflow-x: hidden;
cursor: default;
}

/* ─── NOISE OVERLAY ─── */
body::before {
content: ‘’;
position: fixed;
inset: 0;
background-image: url(“data:image/svg+xml,%3Csvg viewBox=‘0 0 256 256’ xmlns=‘http://www.w3.org/2000/svg’%3E%3Cfilter id=‘noise’%3E%3CfeTurbulence type=‘fractalNoise’ baseFrequency=‘0.9’ numOctaves=‘4’ stitchTiles=‘stitch’/%3E%3C/filter%3E%3Crect width=‘100%25’ height=‘100%25’ filter=‘url(%23noise)’ opacity=‘0.04’/%3E%3C/svg%3E”);
pointer-events: none;
z-index: 9999;
opacity: 0.35;
}

/* ─── NAV ─── */
nav {
position: fixed;
top: 0;
left: 0;
right: 0;
z-index: 100;
display: flex;
justify-content: center;
gap: 0;
background: rgba(5,5,5,0.92);
border-bottom: 1px solid rgba(201,168,76,0.2);
backdrop-filter: blur(12px);
}

.nav-btn {
padding: 18px 60px;
font-family: ‘Cinzel Decorative’, serif;
font-size: 0.75rem;
letter-spacing: 0.3em;
text-transform: uppercase;
color: var(–text-muted);
background: none;
border: none;
cursor: pointer;
transition: all 0.3s;
position: relative;
text-decoration: none;
display: flex;
align-items: center;
gap: 10px;
}

.nav-btn::after {
content: ‘’;
position: absolute;
bottom: 0;
left: 0;
right: 0;
height: 2px;
transform: scaleX(0);
transition: transform 0.3s;
}

.nav-btn.exo { }
.nav-btn.exo::after { background: var(–exo-cyan); }
.nav-btn.exo:hover, .nav-btn.exo.active {
color: var(–exo-cyan);
text-shadow: 0 0 20px rgba(77,208,225,0.5);
}
.nav-btn.exo:hover::after, .nav-btn.exo.active::after { transform: scaleX(1); }

.nav-btn.cult::after { background: var(–cult-accent); }
.nav-btn.cult:hover, .nav-btn.cult.active {
color: var(–cult-accent);
text-shadow: 0 0 20px rgba(255,23,68,0.5);
}
.nav-btn.cult:hover::after, .nav-btn.cult.active::after { transform: scaleX(1); }

.nav-divider {
width: 1px;
background: rgba(201,168,76,0.15);
margin: 12px 0;
}

/* ─── PAGES ─── */
.page {
display: none;
min-height: 100vh;
padding-top: 60px;
}
.page.active { display: block; }

/* ─── HERO ─── */
.hero {
position: relative;
height: 100vh;
display: flex;
flex-direction: column;
align-items: center;
justify-content: center;
text-align: center;
overflow: hidden;
}

.hero-bg-exo {
position: absolute;
inset: 0;
background:
radial-gradient(ellipse 80% 60% at 50% 40%, rgba(26,58,92,0.6) 0%, transparent 70%),
radial-gradient(ellipse 40% 40% at 80% 20%, rgba(77,208,225,0.08) 0%, transparent 60%),
linear-gradient(180deg, #04080f 0%, #000810 60%, #000408 100%);
}

.hero-bg-cult {
position: absolute;
inset: 0;
background:
radial-gradient(ellipse 80% 60% at 50% 40%, rgba(74,0,0,0.7) 0%, transparent 70%),
radial-gradient(ellipse 40% 40% at 20% 20%, rgba(198,40,40,0.1) 0%, transparent 60%),
linear-gradient(180deg, #0d0000 0%, #060000 60%, #080000 100%);
}

/* Floating kanji */
.kanji-bg {
position: absolute;
inset: 0;
pointer-events: none;
overflow: hidden;
}

.kanji-char {
position: absolute;
font-family: ‘Noto Serif JP’, serif;
font-weight: 900;
opacity: 0.03;
animation: floatKanji linear infinite;
}

@keyframes floatKanji {
0% { transform: translateY(100vh) rotate(0deg); opacity: 0; }
10% { opacity: 0.04; }
90% { opacity: 0.04; }
100% { transform: translateY(-20vh) rotate(360deg); opacity: 0; }
}

/* Scan lines */
.scanlines {
position: absolute;
inset: 0;
background: repeating-linear-gradient(
0deg,
transparent,
transparent 2px,
rgba(0,0,0,0.08) 2px,
rgba(0,0,0,0.08) 4px
);
pointer-events: none;
}

.hero-era {
font-family: ‘Bebas Neue’, sans-serif;
font-size: clamp(0.6rem, 1.5vw, 0.85rem);
letter-spacing: 0.5em;
color: var(–gold);
margin-bottom: 20px;
opacity: 0;
animation: fadeUp 1s 0.3s forwards;
}

.hero-title {
font-family: ‘Cinzel Decorative’, serif;
font-size: clamp(2.5rem, 7vw, 6rem);
font-weight: 900;
line-height: 1;
margin-bottom: 16px;
opacity: 0;
animation: fadeUp 1s 0.5s forwards;
}

.hero-title.exo-title {
background: linear-gradient(135deg, #ffffff 0%, var(–exo-cyan) 50%, #ffffff 100%);
-webkit-background-clip: text;
-webkit-text-fill-color: transparent;
background-clip: text;
filter: drop-shadow(0 0 40px rgba(77,208,225,0.3));
}

.hero-title.cult-title {
background: linear-gradient(135deg, #ffffff 0%, var(–cult-accent) 50%, #8b0000 100%);
-webkit-background-clip: text;
-webkit-text-fill-color: transparent;
background-clip: text;
filter: drop-shadow(0 0 40px rgba(255,23,68,0.4));
}

.hero-subtitle {
font-family: ‘Sawarabi Mincho’, serif;
font-size: clamp(0.9rem, 2vw, 1.1rem);
color: var(–text-muted);
letter-spacing: 0.15em;
max-width: 600px;
line-height: 1.8;
opacity: 0;
animation: fadeUp 1s 0.7s forwards;
padding: 0 20px;
}

.hero-line {
width: 120px;
height: 1px;
margin: 28px auto;
opacity: 0;
animation: fadeUp 1s 0.9s forwards;
}

.exo-line { background: linear-gradient(90deg, transparent, var(–exo-cyan), transparent); }
.cult-line { background: linear-gradient(90deg, transparent, var(–cult-accent), transparent); }

.hero-scroll {
position: absolute;
bottom: 40px;
left: 50%;
transform: translateX(-50%);
display: flex;
flex-direction: column;
align-items: center;
gap: 8px;
opacity: 0;
animation: fadeIn 1s 1.5s forwards;
}

.scroll-line {
width: 1px;
height: 50px;
animation: scrollPulse 2s ease-in-out infinite;
}

.exo-scroll-line { background: linear-gradient(180deg, var(–exo-cyan), transparent); }
.cult-scroll-line { background: linear-gradient(180deg, var(–cult-accent), transparent); }

@keyframes scrollPulse {
0%, 100% { opacity: 0.3; transform: scaleY(1); }
50% { opacity: 1; transform: scaleY(1.2); }
}

/* ─── DOCTRINE ─── */
.doctrine-section {
padding: 100px 20px;
max-width: 900px;
margin: 0 auto;
}

.section-label {
font-family: ‘Bebas Neue’, sans-serif;
font-size: 0.7rem;
letter-spacing: 0.5em;
margin-bottom: 12px;
}

.exo-section .section-label { color: var(–exo-accent); }
.cult-section .section-label { color: var(–cult-accent); }

.section-title {
font-family: ‘Cinzel Decorative’, serif;
font-size: clamp(1.8rem, 4vw, 3rem);
font-weight: 700;
margin-bottom: 30px;
line-height: 1.2;
}

.doctrine-text {
font-size: 1.05rem;
line-height: 2;
color: rgba(232,224,208,0.8);
border-left: 2px solid;
padding-left: 24px;
margin-bottom: 40px;
}

.exo-section .doctrine-text { border-color: var(–exo-cyan); }
.cult-section .doctrine-text { border-color: var(–cult-accent); }

/* ─── CLAN CARDS ─── */
.clans-grid {
padding: 0 20px 120px;
max-width: 1200px;
margin: 0 auto;
display: grid;
grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
gap: 24px;
}

.clan-card {
position: relative;
background: var(–dark2);
border: 1px solid rgba(255,255,255,0.06);
overflow: hidden;
transition: transform 0.4s cubic-bezier(0.25, 0.46, 0.45, 0.94), box-shadow 0.4s;
}

.clan-card:hover {
transform: translateY(-6px);
}

.exo-card:hover { box-shadow: 0 20px 60px rgba(77,208,225,0.15), 0 0 0 1px rgba(77,208,225,0.2); }
.cult-card:hover { box-shadow: 0 20px 60px rgba(255,23,68,0.15), 0 0 0 1px rgba(255,23,68,0.2); }

.card-top-bar {
height: 3px;
width: 100%;
}

.exo-bar { background: linear-gradient(90deg, var(–exo-blue), var(–exo-cyan), var(–exo-blue)); }
.cult-bar { background: linear-gradient(90deg, var(–cult-red), var(–cult-accent), var(–cult-red)); }

.card-inner {
padding: 32px;
}

.card-icon {
font-size: 2.2rem;
margin-bottom: 16px;
display: block;
line-height: 1;
}

.card-name {
font-family: ‘Cinzel Decorative’, serif;
font-size: 1.25rem;
font-weight: 700;
margin-bottom: 4px;
letter-spacing: 0.05em;
}

.exo-card .card-name { color: #e8f4f8; }
.cult-card .card-name { color: #ffd0d0; }

.card-subtitle {
font-size: 0.72rem;
letter-spacing: 0.3em;
text-transform: uppercase;
margin-bottom: 20px;
font-family: ‘Bebas Neue’, sans-serif;
}

.exo-card .card-subtitle { color: var(–exo-accent); }
.cult-card .card-subtitle { color: var(–cult-accent); }

.card-divider {
height: 1px;
margin: 20px 0;
background: rgba(255,255,255,0.05);
}

.card-desc {
font-size: 0.92rem;
line-height: 1.9;
color: rgba(232,224,208,0.7);
margin-bottom: 20px;
}

.card-tag {
display: inline-flex;
align-items: center;
gap: 8px;
font-size: 0.7rem;
letter-spacing: 0.2em;
text-transform: uppercase;
padding: 6px 14px;
border: 1px solid;
font-family: ‘Bebas Neue’, sans-serif;
margin-bottom: 8px;
margin-right: 8px;
}

.exo-card .card-tag { border-color: rgba(77,208,225,0.3); color: var(–exo-cyan); }
.cult-card .card-tag { border-color: rgba(255,23,68,0.3); color: var(–cult-accent); }

.card-detail {
font-size: 0.88rem;
line-height: 1.8;
color: rgba(232,224,208,0.6);
padding: 16px;
border-left: 2px solid;
background: rgba(255,255,255,0.02);
margin-top: 16px;
}

.exo-card .card-detail { border-color: rgba(77,208,225,0.4); }
.cult-card .card-detail { border-color: rgba(255,23,68,0.4); }

.detail-label {
font-family: ‘Bebas Neue’, sans-serif;
font-size: 0.65rem;
letter-spacing: 0.35em;
text-transform: uppercase;
margin-bottom: 6px;
display: block;
}

.exo-card .detail-label { color: var(–exo-accent); }
.cult-card .detail-label { color: var(–cult-accent); }

/* ─── ENJEUX SECTION ─── */
.stakes-section {
padding: 80px 20px 120px;
max-width: 1000px;
margin: 0 auto;
}

.stakes-title {
font-family: ‘Cinzel Decorative’, serif;
font-size: clamp(1.4rem, 3vw, 2rem);
color: var(–gold);
text-align: center;
margin-bottom: 60px;
letter-spacing: 0.1em;
}

.stakes-title::before, .stakes-title::after {
content: ‘——’;
margin: 0 16px;
color: var(–gold-light);
opacity: 0.4;
}

.stakes-grid {
display: grid;
grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
gap: 20px;
}

.stake-item {
padding: 28px;
background: var(–dark2);
border: 1px solid rgba(201,168,76,0.1);
position: relative;
transition: border-color 0.3s;
}

.stake-item:hover { border-color: rgba(201,168,76,0.3); }

.stake-num {
font-family: ‘Bebas Neue’, sans-serif;
font-size: 3rem;
color: rgba(201,168,76,0.1);
position: absolute;
top: 12px;
right: 16px;
line-height: 1;
}

.stake-title {
font-family: ‘Cinzel Decorative’, serif;
font-size: 0.9rem;
color: var(–gold);
margin-bottom: 12px;
letter-spacing: 0.05em;
}

.stake-text {
font-size: 0.88rem;
line-height: 1.9;
color: rgba(232,224,208,0.6);
}

/* ─── CONTEXT BANNER ─── */
.context-banner {
padding: 80px 20px;
text-align: center;
position: relative;
overflow: hidden;
}

.context-banner::before {
content: ‘’;
position: absolute;
inset: 0;
background: linear-gradient(180deg, transparent, rgba(201,168,76,0.03), transparent);
}

.banner-title {
font-family: ‘Cinzel Decorative’, serif;
font-size: clamp(1.6rem, 4vw, 2.8rem);
font-weight: 900;
background: linear-gradient(135deg, var(–gold-light), var(–gold), var(–gold-light));
-webkit-background-clip: text;
-webkit-text-fill-color: transparent;
background-clip: text;
margin-bottom: 20px;
letter-spacing: 0.05em;
}

.banner-text {
max-width: 700px;
margin: 0 auto;
font-size: 1rem;
line-height: 2;
color: rgba(232,224,208,0.65);
}

/* ─── PAGE SEPARATOR ─── */
.page-sep {
width: 100%;
height: 1px;
background: linear-gradient(90deg, transparent, rgba(201,168,76,0.3), transparent);
margin: 0;
}

/* ─── ANIMATIONS ─── */
@keyframes fadeUp {
from { opacity: 0; transform: translateY(30px); }
to { opacity: 1; transform: translateY(0); }
}

@keyframes fadeIn {
from { opacity: 0; }
to { opacity: 1; }
}

/* scroll-reveal */
.reveal {
opacity: 0;
transform: translateY(40px);
transition: opacity 0.8s ease, transform 0.8s ease;
}

.reveal.visible {
opacity: 1;
transform: translateY(0);
}

.reveal-delay-1 { transition-delay: 0.1s; }
.reveal-delay-2 { transition-delay: 0.2s; }
.reveal-delay-3 { transition-delay: 0.3s; }
.reveal-delay-4 { transition-delay: 0.4s; }

/* ─── SEAL DECORATION ─── */
.seal {
width: 80px;
height: 80px;
margin: 0 auto 30px;
position: relative;
opacity: 0;
animation: fadeIn 1s 1s forwards;
}

.seal svg {
width: 100%;
height: 100%;
animation: rotateSeal 20s linear infinite;
}

@keyframes rotateSeal {
from { transform: rotate(0deg); }
to { transform: rotate(360deg); }
}

/* ─── RESPONSIVE ─── */
@media (max-width: 600px) {
.nav-btn { padding: 16px 24px; font-size: 0.65rem; letter-spacing: 0.2em; }
.clans-grid { grid-template-columns: 1fr; }
}

/* Background pulse for exo page */
.page-exo { background: radial-gradient(ellipse 100% 50% at 50% 0%, rgba(0,18,40,0.5) 0%, var(–void) 60%); }
.page-cult { background: radial-gradient(ellipse 100% 50% at 50% 0%, rgba(30,0,0,0.5) 0%, var(–void) 60%); }

/* glow pulse */
.glow-exo { animation: glowPulseExo 4s ease-in-out infinite; }
.glow-cult { animation: glowPulseCult 4s ease-in-out infinite; }

@keyframes glowPulseExo {
0%, 100% { filter: drop-shadow(0 0 8px rgba(77,208,225,0.2)); }
50% { filter: drop-shadow(0 0 20px rgba(77,208,225,0.5)); }
}

@keyframes glowPulseCult {
0%, 100% { filter: drop-shadow(0 0 8px rgba(255,23,68,0.2)); }
50% { filter: drop-shadow(0 0 20px rgba(255,23,68,0.5)); }
}
</style>

</head>
